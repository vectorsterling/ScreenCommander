# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Application Settings
LOG_LEVEL=INFO
COMMAND_TIMEOUT=30
SCREEN_CAPTURE_INTERVAL=0.5

# LLM Settings
DEFAULT_LLM_PROVIDER=openai
MAX_TOKENS=150
TEMPERATURE=0.7

# Screen Analysis Settings
MIN_CONFIDENCE_SCORE=0.8
OCR_LANGUAGE=eng

# Action Execution Settings
CLICK_DELAY=0.2
SCROLL_SPEED=100
TYPE_DELAY=0.05

# Error Handling
MAX_RETRIES=3
RETRY_DELAY=1.0

# MacosUseSDK (build with scripts/build-macos-use-sdk.sh)
MACOS_USE_SDK_ROOT=/Users/vector/Code/ScreenCommander/MacosUseSDK
MACOS_USE_INPUT_TOOL=/Users/vector/Code/ScreenCommander/MacosUseSDK/.build/release/InputControllerTool

# MCP server (LAN: bind 0.0.0.0 on Mac Mini)
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_SSE_PATH=/sse
MCP_MESSAGE_PATH=/messages/
# For Cursor on another machine: disable DNS rebinding checks or allow your hostnames
MCP_DISABLE_DNS_REBINDING=true
# MCP_ALLOWED_HOSTS=192.168.0.50:8080,mac-mini.local:8080
