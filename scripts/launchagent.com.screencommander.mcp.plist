<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.screencommander.mcp</string>
  <key>ProgramArguments</key>
  <array>
    <string>python3.13</string>
    <string>-m</string>
    <string>mcp_server</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/vector/Code/ScreenCommander</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/vector/Library/Logs/screencommander.mcp.log</string>
  <key>StandardErrorPath</key><string>/Users/vector/Library/Logs/screencommander.mcp.err</string>
</dict>
</plist>
